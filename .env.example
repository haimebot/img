# Server Configuration
PORT=3000
NODE_ENV=production

# Optional: Custom Remove.bg API Key (Built-in client studio fallback works automatically)
# Obtain a free key at https://www.remove.bg/api
REMOVE_BG_API_KEY=
VITE_REMOVE_BG_API_KEY=

# Optional: Custom ImgBB API Key for cloud hosting processed images
# Obtain a free key at https://api.imgbb.com
IMGBB_API_KEY=
VITE_IMGBB_API_KEY=
